if(NOT DEFINED ENV{TOUCHHLE_BOOST_ROOT})
    message(FATAL_ERROR "TOUCHHLE_BOOST_ROOT is required")
endif()

set(CMAKE_SYSTEM_NAME iOS)
set(CMAKE_SYSTEM_PROCESSOR arm64)
set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "iOS architecture" FORCE)
set(CMAKE_OSX_DEPLOYMENT_TARGET 15.0 CACHE STRING "Minimum iOS version" FORCE)
if(DEFINED ENV{SDKROOT})
    set(CMAKE_OSX_SYSROOT "$ENV{SDKROOT}" CACHE PATH "Apple SDK" FORCE)
endif()

set(Boost_INCLUDE_DIR "$ENV{TOUCHHLE_BOOST_ROOT}" CACHE PATH "Boost headers" FORCE)
set(CMAKE_POLICY_DEFAULT_CMP0167 OLD)
set(CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED NO)
